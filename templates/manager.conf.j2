<ossec_config>

  <!-- ================= GLOBAL SETTINGS ================= -->
  <global>
    <jsonout_output>yes</jsonout_output>
    <alerts_log>yes</alerts_log>
    <logall>no</logall>
    <logall_json>no</logall_json>
    <email_notification>no</email_notification>
    <smtp_server>localhost</smtp_server>
    <email_from>wazuh@localhost</email_from>
    <email_to>admin@localhost</email_to>
    <email_maxperhour>12</email_maxperhour>
  </global>


  <!-- ================= ALERT SETTINGS ================= -->
  <alerts>
    <log_alert_level>1</log_alert_level>
    <email_alert_level>12</email_alert_level>
  </alerts>


  <!-- ================= REMOTE AGENT COMMUNICATION ================= -->
  <remote>
    <connection>secure</connection>
    <port>{{ wazuh_agent_port }}</port>
    <protocol>tcp</protocol>
    <queue_size>131072</queue_size>
  </remote>


  <!-- ================= AGENT ENROLLMENT ================= -->
  <auth>
    <disabled>no</disabled>
    <port>{{ wazuh_enrollment_port }}</port>
    <use_source_ip>yes</use_source_ip>
    <purge>yes</purge>
    <use_password>no</use_password>
  </auth>


  <!-- ================= ROOTCHECK ================= -->
  <rootcheck>
    <disabled>no</disabled>
    <check_unixaudit>yes</check_unixaudit>
    <check_files>yes</check_files>
    <check_trojans>yes</check_trojans>
    <check_dev>yes</check_dev>
    <check_sys>yes</check_sys>
    <check_pids>yes</check_pids>
    <check_ports>yes</check_ports>
    <check_if>yes</check_if>
  </rootcheck>


  <!-- ================= SYSCHECK ================= -->
  <syscheck>
    <disabled>no</disabled>
    <frequency>43200</frequency>
    <scan_on_start>yes</scan_on_start>
    <directories check_all="yes">/etc,/usr/bin,/usr/sbin,/bin,/sbin,/boot</directories>
  </syscheck>


  <!-- ================= LOG COLLECTION ================= -->

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/syslog</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/auth.log</location>
  </localfile>


  <!-- ================= RULESET ================= -->
  <ruleset>
    <decoder_dir>ruleset/decoders</decoder_dir>
    <rule_dir>ruleset/rules</rule_dir>
    <rule_exclude>0215-policy_rules.xml</rule_exclude>
  </ruleset>


  <!-- ================= INDEXER INTEGRATION ================= -->
  <!-- As per Wazuh documentation -->

  <indexer>
    <enabled>yes</enabled>

    <hosts>
      <host>https://{{ wazuh_runtime_host }}:{{ wazuh_indexer_port }}</host>
    </hosts>

    <ssl>
      <certificate_authorities>
        <ca>/etc/filebeat/certs/root-ca.pem</ca>
      </certificate_authorities>

      <certificate>/etc/filebeat/certs/filebeat.pem</certificate>
      <key>/etc/filebeat/certs/filebeat-key.pem</key>
    </ssl>

  </indexer>


  {% if wazuh_deployment_mode != "single" %}

  <!-- ================= CLUSTER CONFIGURATION ================= -->
  <!-- Only used for multi-node deployment -->

  <cluster>
    <name>{{ wazuh_cluster_name }}</name>
    <node_name>{{ inventory_hostname }}</node_name>
    <node_type>master</node_type>
    <key>{{ wazuh_cluster_key }}</key>
    <port>{{ wazuh_cluster_port }}</port>
    <bind_addr>0.0.0.0</bind_addr>

    <nodes>
      {% for host in groups['wazuh_cluster'] | default([]) %}
      <node>{{ hostvars[host]['ansible_host'] | default(host) }}</node>
      {% endfor %}
    </nodes>

    <hidden>no</hidden>
    <disabled>no</disabled>
  </cluster>

  {% endif %}

</ossec_config>