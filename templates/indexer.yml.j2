# =====================================================
# Wazuh Indexer (OpenSearch) Configuration
# =====================================================

cluster.name: {{ wazuh_cluster_name }}
node.name: {{ inventory_hostname }}

network.host: {{ wazuh_bind_address }}
http.port: {{ wazuh_indexer_port }}

path.data: {{ wazuh_indexer_data_dir }}
path.logs: {{ wazuh_log_dir }}

# =====================================================
# Discovery / Cluster Mode
# =====================================================

{% if wazuh_deployment_mode == "single" %}

discovery.type: single-node

{% else %}

discovery.seed_hosts: {{ wazuh_cluster_nodes }}
cluster.initial_master_nodes: {{ wazuh_cluster_initial_masters }}

{% endif %}

# =====================================================
# Security / TLS Configuration
# =====================================================

# =====================================================
# Security / TLS Configuration
# =====================================================

{% if wazuh_tls_enabled | bool %}

plugins.security.disabled: false

plugins.security.ssl.http.enabled: true
plugins.security.ssl.http.pemcert_filepath: {{ wazuh_tls_cert_file }}
plugins.security.ssl.http.pemkey_filepath: {{ wazuh_tls_key_file }}
plugins.security.ssl.http.pemtrustedcas_filepath: {{ wazuh_tls_ca_file }}

plugins.security.ssl.transport.enabled: true
plugins.security.ssl.transport.pemcert_filepath: {{ wazuh_tls_cert_file }}
plugins.security.ssl.transport.pemkey_filepath: {{ wazuh_tls_key_file }}
plugins.security.ssl.transport.pemtrustedcas_filepath: {{ wazuh_tls_ca_file }}

plugins.security.authcz.admin_dn:
  - "{{ wazuh_admin_dn }}"

{% else %}

# Disable security plugin completely (LAB / Non-TLS mode)

plugins.security.disabled: true
plugins.security.ssl.http.enabled: false
plugins.security.ssl.transport.enabled: false

{% endif %}